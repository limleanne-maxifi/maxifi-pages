<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>AI Visibility Test — Maxifi Digital</title>
<meta name="description" content="Enter your brand name and a query your buyers ask AI. See how a Maxifi audit works across ChatGPT, Claude, Gemini, Perplexity, and Google AI Overviews.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=JetBrains+Mono:wght@400&display=swap">
<style>
:root {
  --sans:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,"Cascadia Code",monospace;
  --primary:#1D4ED8; --primary-hover:#1E40AF; --on-primary:#ffffff;
  --canvas:#FBFAF6; --layer:#ffffff; --field:#f7f6f2;
  --hairline:#E7E4DC; --border-strong:#CFCBC0;
  --ink:#16181D; --ink-muted:#4B4F58; --ink-subtle:#71757E;
  --dark:#16181D; --container:1056px;
  --cited-fg:#0e6027; --cited-bg:#d9f0e0;
  --missing-fg:#7a1521; --missing-bg:#fbdcde;
  --header-bg:rgba(251,250,246,.94);
  --sample-bg:#fdf7e7; --sample-fg:#684e00; --sample-border:#f1c21b;
  --logo-filter:none;
}
@media (prefers-color-scheme:dark) {
  :root:not([data-theme="light"]) {
    --canvas:#0f1117; --layer:#1a1d26; --field:#13151c;
    --hairline:#252932; --border-strong:#333849;
    --ink:#eeedf2; --ink-muted:#a8abb4; --ink-subtle:#6e7280;
    --dark:#090b10; --cited-fg:#5edb8a; --cited-bg:#0b2817;
    --missing-fg:#f07070; --missing-bg:#2d0f0f;
    --header-bg:rgba(15,17,23,.94);
    --sample-bg:#2a1e00; --sample-fg:#fbbf24;
    --logo-filter:invert(1);
  }
}
:root[data-theme="dark"] {
  --canvas:#0f1117; --layer:#1a1d26; --field:#13151c;
  --hairline:#252932; --border-strong:#333849;
  --ink:#eeedf2; --ink-muted:#a8abb4; --ink-subtle:#6e7280;
  --dark:#090b10; --cited-fg:#5edb8a; --cited-bg:#0b2817;
  --missing-fg:#f07070; --missing-bg:#2d0f0f;
  --header-bg:rgba(15,17,23,.94);
  --sample-bg:#2a1e00; --sample-fg:#fbbf24;
  --logo-filter:invert(1);
}
*,*::before,*::after{box-sizing:border-box;}
[hidden]{display:none!important;}
html{scroll-behavior:smooth;}
body{margin:0;background:var(--canvas);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased;font-weight:300;}
a{color:inherit;text-decoration:none;}
.mx-container{max-width:var(--container);margin:0 auto;padding:0 32px;}
@media(max-width:680px){.mx-container{padding:0 20px;}}
.mx-section{padding:56px 0;}
.mx-eyebrow{font-size:11px;letter-spacing:.5px;text-transform:uppercase;color:var(--primary);font-weight:600;display:flex;align-items:center;}
.mx-acc-line{display:inline-block;width:24px;height:1px;background:var(--primary);margin-right:12px;flex-shrink:0;}
.mx-h2{font-weight:300;font-size:clamp(28px,3.4vw,44px);line-height:1.1;letter-spacing:-.012em;margin:0;text-wrap:balance;}
.mx-body{font-size:16px;line-height:1.55;color:var(--ink-muted);}
.mx-btn{display:inline-flex;align-items:center;gap:10px;font-size:14px;font-weight:400;padding:13px 20px;border-radius:0;border:1px solid transparent;background:var(--primary);color:var(--on-primary);cursor:pointer;text-decoration:none;white-space:nowrap;transition:background 200ms;font-family:var(--sans);}
.mx-btn:hover{background:var(--primary-hover);}
.mx-btn:disabled{opacity:.5;cursor:not-allowed;}
.mx-btn.is-secondary{background:transparent;color:var(--primary);border-color:var(--primary);}
.mx-btn.is-secondary:hover{background:rgba(29,78,216,.08);}
.mx-btn.is-sm{padding:9px 16px;font-size:13px;}
.mx-btn.is-on-dark{background:#fff;color:var(--primary);}
.mx-btn.is-on-dark:hover{background:#e8edf8;}
.mx-btn.is-ghost-dark{background:transparent;border:1px solid rgba(255,255,255,.35);color:#fff;}
.mx-btn.is-ghost-dark:hover{background:rgba(255,255,255,.08);}
.mx-card{background:var(--layer);border:1px solid var(--hairline);padding:24px;}
.cta-row{display:flex;gap:12px;flex-wrap:wrap;}

.c-header{position:sticky;top:0;z-index:50;background:var(--header-bg);backdrop-filter:saturate(140%) blur(12px);-webkit-backdrop-filter:saturate(140%) blur(12px);border-bottom:1px solid var(--hairline);}
.c-header .bar{display:flex;align-items:center;justify-content:space-between;padding:12px 0;gap:12px;}
.mx-logo{display:inline-flex;align-items:center;text-decoration:none;}
.mx-logo-img{display:block;height:36px;width:auto;filter:var(--logo-filter);}

.hero{padding:60px 0 52px;position:relative;overflow:hidden;}
.hero-glow{position:absolute;top:-180px;right:-100px;width:600px;height:600px;border-radius:50%;background:radial-gradient(closest-side,rgba(29,78,216,.065),transparent 70%);pointer-events:none;}

.test-form{margin-top:32px;background:var(--layer);border:1px solid var(--hairline);padding:28px 28px 24px;max-width:680px;}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
@media(max-width:600px){.form-row{grid-template-columns:1fr;}}
.form-field{display:flex;flex-direction:column;gap:6px;}
.form-field label{font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:var(--ink-subtle);font-weight:600;}
.form-input{width:100%;padding:11px 13px;border:1px solid var(--border-strong);font-family:var(--sans);font-size:15px;color:var(--ink);background:var(--field);outline:none;transition:border-color 150ms;}
.form-input:focus{border-color:var(--primary);}
.form-input::placeholder{color:var(--ink-subtle);font-weight:300;}
.form-footer{margin-top:18px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;}
.form-note{font-size:12px;color:var(--ink-subtle);line-height:1.5;}

.engine-bar{margin-top:28px;display:flex;gap:8px;flex-wrap:wrap;}
.eng-pill{display:inline-flex;align-items:center;gap:7px;font-size:12px;color:var(--ink-muted);background:var(--field);border:1px solid var(--hairline);padding:5px 11px;transition:all 200ms;}
.eng-pill.running{border-color:var(--primary);color:var(--primary);}
.eng-pill.done-named{border-color:var(--cited-fg);color:var(--cited-fg);background:var(--cited-bg);}
.eng-pill.done-missed{border-color:var(--missing-fg);color:var(--missing-fg);background:var(--missing-bg);}
.eng-dot{width:6px;height:6px;border-radius:50%;background:currentColor;flex-shrink:0;}
.eng-pulse{width:6px;height:6px;border-radius:50%;background:var(--primary);flex-shrink:0;animation:engPulse 1s ease-out infinite;}

.samplebar{padding:11px 14px;font-size:12px;font-weight:600;letter-spacing:.02em;background:var(--sample-bg);color:var(--sample-fg);border-left:3px solid var(--sample-border);margin-bottom:20px;}
.summary{display:flex;align-items:center;gap:24px;border:1px solid var(--hairline);background:var(--field);padding:20px 24px;margin-bottom:24px;}
.summary .score{font-weight:300;font-size:42px;min-width:84px;text-align:center;letter-spacing:-1px;color:var(--primary);font-variant-numeric:tabular-nums;line-height:1;}
.summary .slab{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-subtle);margin-bottom:6px;}
.summary .headline{font-weight:400;font-size:18px;line-height:1.3;}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));}
.tile{display:flex;flex-direction:column;gap:10px;position:relative;min-height:140px;}
.thead{display:flex;flex-direction:column;gap:3px;}
.tname{font-weight:600;font-size:16px;}
.tile-meta{margin:0;font-size:11.5px;letter-spacing:.03em;color:var(--ink-subtle);font-family:var(--mono);}
.status{font-size:13px;font-weight:600;display:inline-flex;align-items:center;align-self:flex-start;padding:3px 8px;}
.status.named{color:var(--cited-fg);background:var(--cited-bg);}
.status.missed{color:var(--missing-fg);background:var(--missing-bg);}
.toggle{align-self:flex-start;background:none;border:0;padding:0 0 1px;cursor:pointer;font-family:var(--sans);font-size:13px;color:var(--primary);border-bottom:1px solid var(--hairline);}
.body-text{font-size:13.5px;line-height:1.55;color:var(--ink-muted);background:var(--field);border:1px solid var(--hairline);padding:12px;max-height:190px;overflow:auto;white-space:pre-wrap;}

.skeleton{background:var(--hairline);border-radius:2px;animation:shimmer 1.4s ease-in-out infinite;}
.sk-h{height:16px;width:55%;margin-bottom:8px;}
.sk-s{height:11px;width:35%;margin-bottom:12px;}
.sk-b{height:22px;width:70px;}
@keyframes shimmer{0%,100%{opacity:.4;}50%{opacity:.9;}}

.measure-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:28px;}
@media(max-width:820px){.measure-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:480px){.measure-grid{grid-template-columns:1fr;}}
.measure-card{background:var(--layer);border:1px solid var(--hairline);padding:18px;display:flex;flex-direction:column;gap:8px;}
.measure-name{font-weight:600;font-size:14px;}
.measure-sub{font-size:12px;color:var(--ink-subtle);line-height:1.4;}
.measure-badge{font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-subtle);padding:3px 7px;border:1px solid var(--hairline);align-self:flex-start;}

.calc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:28px;}
@media(max-width:820px){.calc-grid{grid-template-columns:1fr;}}
.calc-cell label{display:flex;flex-direction:column;gap:2px;font-size:13px;color:var(--ink);margin-bottom:7px;}
.calc-cell .letter{font-size:22px;font-weight:600;color:var(--primary);line-height:1;}
.calc-cell .hint{font-size:12px;color:var(--ink-subtle);font-weight:300;}
.calc-val{width:100%;padding:10px 12px;border:1px solid var(--border-strong);font-family:var(--mono);font-size:14px;color:var(--ink);background:var(--field);font-variant-numeric:tabular-nums;}
.formula-echo{margin-top:18px;font-size:13px;color:var(--ink-muted);background:var(--layer);border:1px solid var(--hairline);padding:12px 14px;font-variant-numeric:tabular-nums;overflow-x:auto;font-family:var(--mono);line-height:1.6;}
.calc-out{margin-top:26px;display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
@media(max-width:820px){.calc-out{grid-template-columns:1fr;}}
.out-card{background:var(--layer);border:1px solid var(--hairline);padding:20px;}
.out-card .olabel{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-subtle);}
.out-card .onum{font-size:32px;font-weight:300;letter-spacing:-.5px;margin:8px 0 4px;font-variant-numeric:tabular-nums;color:var(--ink);}
.out-card .odetail{font-size:12.5px;color:var(--ink-muted);line-height:1.5;}
.calc-foot{margin-top:16px;font-size:12px;color:var(--ink-subtle);}

.upsell{background:var(--dark);color:#f4f4f4;}
.upsell .mx-eyebrow{color:#93b4f5;}
.upsell .mx-acc-line{background:#93b4f5;}
.upsell .mx-h2{color:#fff;}
.upsell p{color:#c6c6c6;max-width:54ch;margin:18px 0 28px;font-size:18px;}

footer{background:var(--canvas);border-top:1px solid var(--hairline);padding:40px 0;}
footer .frow{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;}
footer .fnote{margin-top:18px;color:var(--ink-subtle);font-size:11px;line-height:1.7;}

@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto;}}
@keyframes engPulse{0%{box-shadow:0 0 0 0 rgba(29,78,216,.5);}70%,100%{box-shadow:0 0 0 6px rgba(29,78,216,0);}}
</style>
</head>
<body>

<header class="c-header">
  <div class="mx-container">
    <div class="bar">
      <a class="mx-logo" href="https://maxifidigital.com">
        <img class="mx-logo-img" src="/images/maxifi-digital-logo-black-transparent.png" alt="Maxifi Digital" width="135" height="44" loading="eager">
      </a>
      <a class="mx-btn is-sm" href="https://lunacal.ai/maxifidigital" target="_blank" rel="noopener">Book a call</a>
    </div>
  </div>
</header>

<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="mx-container">
    <div class="mx-eyebrow"><span class="mx-acc-line"></span>AI Visibility Test</div>
    <h1 class="mx-h2" style="margin-top:10px;max-width:22ch;">See what the engines say about your brand.</h1>
    <p class="mx-body" style="max-width:50ch;margin-top:16px;">Enter your brand name and a query your buyers ask AI. This demo shows the methodology and output format of a real audit across ChatGPT, Claude, Gemini, Perplexity, and Google AI Overviews.</p>

    <div class="test-form">
      <div class="form-row">
        <div class="form-field">
          <label for="brandInput">Brand name</label>
          <input class="form-input" id="brandInput" type="text" placeholder="e.g. Acme Corp" autocomplete="off" spellcheck="false">
        </div>
        <div class="form-field">
          <label for="queryInput">Query to test</label>
          <input class="form-input" id="queryInput" type="text" placeholder="e.g. Who are the leading providers of&hellip;" autocomplete="off">
        </div>
      </div>
      <div class="form-footer">
        <span class="form-note">Results shown are illustrative &mdash; demonstrating the methodology and output format of a real audit.<br>For a live scan of your actual brand, <a href="https://checkyourvisibility.maxifidigital.com" target="_blank" rel="noopener" style="color:var(--primary);border-bottom:1px solid var(--hairline);">run your free snapshot &rarr;</a></span>
        <button class="mx-btn" id="runBtn" onclick="runDemo()">Run test &rarr;</button>
      </div>
    </div>

    <div class="engine-bar" id="engineBar" hidden>
      <span class="eng-pill" id="pill-chatgpt"><span class="eng-dot"></span>ChatGPT</span>
      <span class="eng-pill" id="pill-perplexity"><span class="eng-dot"></span>Perplexity</span>
      <span class="eng-pill" id="pill-gemini"><span class="eng-dot"></span>Gemini</span>
      <span class="eng-pill" id="pill-aio"><span class="eng-dot"></span>Google AI Overviews</span>
      <span class="eng-pill" id="pill-claude"><span class="eng-dot"></span>Claude</span>
    </div>
  </div>
</section>

<section id="resultsSection" class="mx-section" style="padding-top:0;" hidden>
  <div class="mx-container">
    <p class="samplebar">Illustrative results &mdash; showing how a real audit looks for <strong id="brandLabel">your brand</strong></p>
    <div class="summary">
      <div class="score" id="scoreDisplay">&#8212;</div>
      <div>
        <div class="slab">AI Visibility Score</div>
        <div class="headline" id="summaryText">Running&hellip;</div>
      </div>
    </div>
    <div class="grid" id="resultsGrid"></div>
    <p style="margin-top:20px;font-size:12.5px;color:var(--ink-subtle);">Named = engine states the brand name in its answer. Cited = a source link to the brand&rsquo;s domain is returned. Only Perplexity and Google AI Overviews return verifiable source links in this methodology.</p>
    <div style="margin-top:28px;display:flex;gap:12px;flex-wrap:wrap;">
      <a class="mx-btn" href="https://checkyourvisibility.maxifidigital.com" target="_blank" rel="noopener">Run your actual brand scan &rarr;</a>
      <a class="mx-btn is-secondary" href="https://lunacal.ai/maxifidigital" target="_blank" rel="noopener">Talk to us about the full audit</a>
    </div>
  </div>
</section>

<section class="mx-section" style="background:var(--layer);border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline);">
  <div class="mx-container">
    <div class="mx-eyebrow"><span class="mx-acc-line"></span>The five engines</div>
    <h2 class="mx-h2" style="margin-top:10px;">Every engine your buyers are already using</h2>
    <p class="mx-body" style="max-width:52ch;margin-top:14px;">AI answers now intercept 40&ndash;60% of research queries before any click reaches a website. We measure across all five live answer engines simultaneously.</p>
    <div class="measure-grid">
      <div class="measure-card">
        <div class="measure-name">ChatGPT</div>
        <div class="measure-badge">Named</div>
        <div class="measure-sub">GPT-4o direct-answer completions across your query set</div>
      </div>
      <div class="measure-card">
        <div class="measure-name">Perplexity</div>
        <div class="measure-badge">Named + cited</div>
        <div class="measure-sub">Answer + source link verification against your domain</div>
      </div>
      <div class="measure-card">
        <div class="measure-name">Gemini</div>
        <div class="measure-badge">Named</div>
        <div class="measure-sub">Google&rsquo;s Gemini 1.5 Pro answer-mode completions</div>
      </div>
      <div class="measure-card">
        <div class="measure-name">Google AI&nbsp;Overviews</div>
        <div class="measure-badge">Named + cited</div>
        <div class="measure-sub">SGE / AI Overview snippets with source attribution</div>
      </div>
      <div class="measure-card">
        <div class="measure-name">Claude</div>
        <div class="measure-badge">Named</div>
        <div class="measure-sub">Anthropic Claude answer-mode direct completions</div>
      </div>
    </div>
  </div>
</section>

<section class="mx-section">
  <div class="mx-container">
    <div class="mx-eyebrow"><span class="mx-acc-line"></span>Value at stake</div>
    <h2 class="mx-h2" style="margin-top:10px;">What does AI invisibility cost your brand?</h2>
    <p class="mx-body" style="max-width:52ch;margin-top:14px;">The MAXIFI equation models the revenue at risk when AI engines answer your buyers&rsquo; questions without naming you. Adjust the inputs for your market.</p>
    <div class="calc-grid">
      <div class="mx-card calc-cell">
        <label><span class="letter">M</span><span>Monthly AI queries in your category</span><span class="hint">Estimated searches answered by AI per month</span></label>
        <input class="calc-val" id="inM" type="number" value="500" min="1">
      </div>
      <div class="mx-card calc-cell">
        <label><span class="letter">A</span><span>Audience match rate</span><span class="hint">Share of those queries from your target buyers</span></label>
        <input class="calc-val" id="inA" type="number" value="0.4" step="0.05" min="0" max="1">
      </div>
      <div class="mx-card calc-cell">
        <label><span class="letter">X</span><span>AI-influenced conversion rate</span><span class="hint">Probability an AI mention converts to enquiry</span></label>
        <input class="calc-val" id="inX" type="number" value="0.05" step="0.01" min="0" max="1">
      </div>
      <div class="mx-card calc-cell">
        <label><span class="letter">I</span><span>Influence coefficient</span><span class="hint">How strongly AI answers shape purchase decisions</span></label>
        <input class="calc-val" id="inI" type="number" value="0.06" step="0.01" min="0" max="1">
      </div>
      <div class="mx-card calc-cell">
        <label><span class="letter">F</span><span>Fulfilment rate</span><span class="hint">Share of enquiries you can actually service</span></label>
        <input class="calc-val" id="inF" type="number" value="1.0" step="0.05" min="0" max="1">
      </div>
      <div class="mx-card calc-cell">
        <label><span class="letter">I</span><span>Income per conversion ($)</span><span class="hint">Average revenue per won deal</span></label>
        <input class="calc-val" id="inInc" type="number" value="25000" min="0">
      </div>
    </div>
    <div class="formula-echo">M &times; A &times; X &times; I &times; F &times; Income = &nbsp;<strong id="formulaResult">$15,000</strong> &nbsp;/ month</div>
    <div class="calc-out">
      <div class="out-card">
        <div class="olabel">Monthly value at stake</div>
        <div class="onum" id="outMonthly">$15,000</div>
        <div class="odetail">Revenue your brand could influence if AI fully named you in every relevant query.</div>
      </div>
      <div class="out-card">
        <div class="olabel">Annual value at stake</div>
        <div class="onum" id="outAnnual">$180,000</div>
        <div class="odetail">Compounded across a full year of AI-intercepted queries.</div>
      </div>
      <div class="out-card">
        <div class="olabel">Maxifi programme fee</div>
        <div class="onum">$4,500</div>
        <div class="odetail">Typical engagement. Payback period against annual value at stake:</div>
        <div class="onum" id="outPayback" style="font-size:20px;margin-top:8px;">9 days</div>
      </div>
    </div>
    <p class="calc-foot">Illustrative model only &mdash; actual results depend on category query volume, competitive density, and engine behaviour at time of measurement.</p>
  </div>
</section>

<section class="mx-section upsell">
  <div class="mx-container">
    <div class="mx-eyebrow"><span class="mx-acc-line"></span>Start here</div>
    <h2 class="mx-h2" style="margin-top:10px;">See where AI puts your brand today</h2>
    <p>Run a free snapshot in under two minutes, or book a call and we&rsquo;ll walk through a full audit &mdash; every query, every engine, the revenue model built around your numbers.</p>
    <div class="cta-row">
      <a class="mx-btn is-on-dark" href="https://checkyourvisibility.maxifidigital.com" target="_blank" rel="noopener">Run your free snapshot</a>
      <a class="mx-btn is-ghost-dark" href="https://lunacal.ai/maxifidigital" target="_blank" rel="noopener">Book a 30-minute strategy call</a>
    </div>
  </div>
</section>

<footer>
  <div class="mx-container">
    <div class="frow">
      <a class="mx-logo" href="https://maxifidigital.com">
        <img class="mx-logo-img" src="/images/maxifi-digital-logo-black-transparent.png" alt="Maxifi Digital" width="135" height="44" loading="lazy">
      </a>
      <span style="font-size:13px;color:var(--ink-subtle);">Maxifi Digital &mdash; Singapore-based, serving clients internationally</span>
    </div>
    <p class="fnote">&copy; 2026 Maxifi Digital Pte Ltd. Results shown on this page are illustrative, produced using representative query patterns to demonstrate the audit methodology.</p>
  </div>
</footer>

<script>
(function () {
  var ENGINES = [
    {
      id: 'chatgpt', label: 'ChatGPT', named: true,
      sub: 'GPT-4o · direct completion',
      snippet: '"[BRAND] is widely regarded as a leading provider in this category. Their track record and client roster make them a strong recommendation for buyers evaluating this type of solution."'
    },
    {
      id: 'perplexity', label: 'Perplexity', named: false,
      sub: 'Perplexity AI · with citations',
      snippet: 'The leading providers in this category include several established firms. Evaluators typically shortlist based on case studies, pricing, and regional coverage. [Source: industry-directory.com]'
    },
    {
      id: 'gemini', label: 'Gemini', named: true,
      sub: 'Google · Gemini 1.5 Pro',
      snippet: '"When considering options in this space, [BRAND] is frequently mentioned alongside two or three other specialist providers. The choice often comes down to specific use-case fit."'
    },
    {
      id: 'aio', label: 'Google AI Overviews', named: false,
      sub: 'Google · SGE / AI Overviews',
      snippet: 'For this category, buyers typically evaluate providers based on certifications, references, and pricing. A number of firms operate in this space across different geographies and verticals. [Source: sectordirectory.org]'
    },
    {
      id: 'claude', label: 'Claude', named: true,
      sub: 'Anthropic · Claude 3.5',
      snippet: '"I can mention [BRAND] as one of the recognised names in this space. Based on my training data they have a meaningful presence and are considered by buyers evaluating providers in this sector."'
    }
  ];

  var DELAYS = [1100, 2300, 1700, 2900, 1500];

  window.runDemo = function () {
    var brand = document.getElementById('brandInput').value.trim() || 'Your brand';
    var btn = document.getElementById('runBtn');
    btn.disabled = true;
    btn.textContent = 'Running…';

    document.getElementById('engineBar').hidden = false;
    ENGINES.forEach(function (e) {
      var p = document.getElementById('pill-' + e.id);
      p.className = 'eng-pill';
      p.innerHTML = '<span class="eng-dot"></span>' + e.label;
    });

    document.getElementById('brandLabel').textContent = brand;
    document.getElementById('scoreDisplay').textContent = '—';
    document.getElementById('summaryText').textContent = 'Querying engines…';

    var grid = document.getElementById('resultsGrid');
    grid.innerHTML = '';
    ENGINES.forEach(function (e) {
      var d = document.createElement('div');
      d.className = 'mx-card tile';
      d.id = 'tile-' + e.id;
      d.innerHTML = '<div class="skeleton sk-h"></div><div class="skeleton sk-s"></div><div class="skeleton sk-b"></div>';
      grid.appendChild(d);
    });

    document.getElementById('resultsSection').hidden = false;
    setTimeout(function () {
      document.getElementById('resultsSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 80);

    var resolved = 0;
    ENGINES.forEach(function (e, idx) {
      var delay = DELAYS.slice(0, idx).reduce(function (a, b) { return a + b; }, 0);
      setTimeout(function () {
        var pill = document.getElementById('pill-' + e.id);
        pill.className = 'eng-pill running';
        pill.innerHTML = '<span class="eng-pulse"></span>' + e.label;
        setTimeout(function () {
          pill.className = 'eng-pill ' + (e.named ? 'done-named' : 'done-missed');
          pill.innerHTML = '<span class="eng-dot"></span>' + (e.named ? '✓ ' : '× ') + e.label;
          var snippet = e.snippet.replace(/\[BRAND\]/g, brand);
          var tile = document.getElementById('tile-' + e.id);
          tile.innerHTML =
            '<div class="thead"><div class="tname">' + e.label + '</div><p class="tile-meta">' + e.sub + '</p></div>' +
            '<span class="status ' + (e.named ? 'named' : 'missed') + '">' + (e.named ? '✓ Named' : '× Not mentioned') + '</span>' +
            '<p class="tile-meta">' + (e.named ? 'Named in direct answer · illustrative' : 'Not named in this response · illustrative') + '</p>' +
            '<button class="toggle" onclick="this.nextElementSibling.hidden=!this.nextElementSibling.hidden">Show response</button>' +
            '<div class="body-text" hidden>' + snippet + '</div>';
          resolved++;
          if (resolved === ENGINES.length) {
            var named = ENGINES.filter(function (x) { return x.named; }).length;
            document.getElementById('scoreDisplay').textContent = named + '/' + ENGINES.length;
            document.getElementById('summaryText').textContent =
              brand + ' is named by ' + named + ' of ' + ENGINES.length + ' measured engines. ' +
              (ENGINES.length - named) + ' engine' + (ENGINES.length - named !== 1 ? 's are' : ' is') +
              ' answering your category question without mentioning you.';
            btn.disabled = false;
            btn.textContent = 'Run again →';
          }
        }, 650);
      }, delay);
    });
  };

  ['brandInput', 'queryInput'].forEach(function (id) {
    document.getElementById(id).addEventListener('keydown', function (e) {
      if (e.key === 'Enter') window.runDemo();
    });
  });

  function calcUpdate() {
    var m = +document.getElementById('inM').value || 0,
        a = +document.getElementById('inA').value || 0,
        x = +document.getElementById('inX').value || 0,
        i = +document.getElementById('inI').value || 0,
        f = +document.getElementById('inF').value || 0,
        inc = +document.getElementById('inInc').value || 0;
    var monthly = m * a * x * i * f * inc, annual = monthly * 12;
    var payback = annual > 0 ? Math.round(4500 / annual * 365) : 0;
    var fmt = function (n) { return '$' + Math.round(n).toLocaleString(); };
    document.getElementById('outMonthly').textContent = fmt(monthly);
    document.getElementById('outAnnual').textContent = fmt(annual);
    document.getElementById('formulaResult').textContent = fmt(monthly);
    document.getElementById('outPayback').textContent = payback > 365 ? '>365 days' : payback + ' days';
  }

  ['inM', 'inA', 'inX', 'inI', 'inF', 'inInc'].forEach(function (id) {
    document.getElementById(id).addEventListener('input', calcUpdate);
  });
  calcUpdate();
}());
</script>

</body>
</html>
